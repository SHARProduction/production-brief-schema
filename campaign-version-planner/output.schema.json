{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign plan output 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "valid",
    "errors",
    "warnings",
    "versions",
    "total"
  ],
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "versions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "channelId",
          "channelLabel",
          "aspectRatio",
          "locale",
          "durationSeconds"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "channelId": {
            "type": "string"
          },
          "channelLabel": {
            "type": "string"
          },
          "aspectRatio": {
            "type": "string",
            "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
          },
          "locale": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "code",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
