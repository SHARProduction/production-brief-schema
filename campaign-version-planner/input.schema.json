{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shar:campaign-version-planner:0.1.0",
  "title": "Campaign version planner input 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "durations",
    "channels",
    "locales"
  ],
  "properties": {
    "durations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "aspectRatios"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^(?!\\s*[=+@-])(?=.*\\S)[^\\u0000-\\u001f\\u007f<>]+$"
          },
          "aspectRatios": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[1-9][0-9]?:[1-9][0-9]?$"
            }
          }
        }
      }
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 35,
        "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8}){0,3}$"
      }
    }
  },
  "x-application-rules": [
    "Duplicates produce warnings and are deduplicated; locales lowercase; channel repeats merge ratios only when effective labels match.",
    "Normalized total durations * locales * sum(channel ratios) must not exceed 1000.",
    "Different ratio strings are distinct; no inference of platform support or mathematical ratio equivalence."
  ]
}
